# Copy this file to .env and fill in real values. Never commit .env.

# --- Required to start the bot at all ---
TOKEN=                    # Discord bot token (Discord Developer Portal > your app > Bot > Reset Token)
OWNER_ID=                 # Your numeric Discord user ID (enable Developer Mode in Discord, right-click your profile > Copy User ID)

# --- Required only for specific commands ---
REDDIT_CLIENT_ID=         # /reddit command. From reddit.com/prefs/apps > create app (type: script)
REDDIT_CLIENT_SECRET=     # /reddit command. Same app as above
REDDIT_USER_AGENT=        # /reddit command. Any descriptive string, e.g. "Shouko-chan/1.0 by <your-reddit-username>"
OPENWEATHER_API_KEY=      # /weather command. From home.openweathermap.org/api_keys (free tier)
RULE34_API_KEY=           # /hentai command. From rule34.xxx account > Account > API Access Credentials
RULE34_USER_ID=           # /hentai command. Same page as above

# --- Optional ---
OPENTDB_TOKEN=            # /trivia. Not needed — the bot requests its own session token from opentdb.com at runtime if unset
CRYPTO_API_KEY=           # /crypto. Not needed — hits Coinbase's public spot price endpoint; only used as an optional bearer token if set
